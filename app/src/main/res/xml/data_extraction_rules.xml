<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and above; see backup_rules.xml for the older equivalent. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
